{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jstack.local/schemas/reports/report-payload-v1.json",
  "title": "ReportPayload",
  "description": "GENERATED FILE — do not edit by hand. Produced from the Zod schema in types/report-payload-v1.ts by `bun run report-schema:generate`. That Zod schema is the contract `jstack report render` and the dashboard preview actually enforce; this file is its human- and agent-readable projection. `bun run check` fails if the two drift apart.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "report_kind": {
          "type": "string",
          "enum": [
            "team-weekly",
            "engineer-weekly",
            "manager-rollup",
            "project-status",
            "sprint-summary",
            "incident-retro",
            "eval-report",
            "self-report",
            "generic"
          ]
        },
        "subtitle": {
          "type": "string"
        },
        "footer_note": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "generated_at"
      ],
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "chart": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "bar",
                      "line",
                      "doughnut"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "datasets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "backgroundColor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        },
                        "borderColor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        },
                        "fill": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "label",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "stacked": {
                        "type": "boolean"
                      },
                      "y_axis_begin_at_zero": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "labels",
                  "datasets"
                ],
                "additionalProperties": false
              },
              "body_markdown": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "chart"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "chart": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "bar",
                      "line",
                      "doughnut"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "datasets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "backgroundColor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        },
                        "borderColor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        },
                        "fill": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "label",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "stacked": {
                        "type": "boolean"
                      },
                      "y_axis_begin_at_zero": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "labels",
                  "datasets"
                ],
                "additionalProperties": false
              },
              "body_markdown": {
                "type": "string"
              }
            },
            "required": [
              "body_markdown"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(https?:|mailto:)"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "meta"
  ],
  "additionalProperties": true
}
