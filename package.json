{
  "name": "jstack-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "jstack contributors"
  },
  "homepage": "https://github.com/boice-gusto/jstack.core",
  "license": "MIT",
  "keywords": [
    "claude",
    "cursor",
    "codex",
    "plugin",
    "team-ops",
    "project-management",
    "sprint",
    "engineering",
    "incident",
    "knowledge"
  ],
  "scripts": {
    "dev": "cd dashboard && bun run dev",
    "check:gusto": "cd ../jstack.gusto && bun run check",
    "check:all": "bun run check && cd ../jstack.gusto && bun run check",
    "apply-skills": "python3 scripts/apply_detailed_skills.py",
    "validate-config": "bun run scripts/validate-config.ts",
    "eval": "bun run evals/run-evals.ts",
    "eval:quick": "bun run evals/run-evals.ts quick",
    "eval:semantic": "bun run evals/run-evals.ts semantic",
    "eval:validate": "bun run evals/run-evals.ts validate",
    "eval:scenarios": "bun run evals/run-evals.ts scenarios",
    "eval:scenarios-validate": "bun run evals/run-evals.ts scenarios-validate",
    "eval:routers": "bun run scripts/validate-router-matrix.ts",
    "validate-chains": "bun run scripts/validate-chains.ts",
    "validate:alias-drift": "bun run scripts/validate-skill-alias-drift.ts",
    "deep-dive:status": "bun run scripts/deep-dive-wave-status.ts",
    "eval:coverage": "bun run evals/run-evals.ts coverage",
    "generate-skill-evals": "bun run scripts/generate-skill-evals.ts",
    "docs:generate": "bun run scripts/generate-docs-data.ts",
    "docs:build": "bun run scripts/build-landing-page.ts",
    "docs:serve": "bun run scripts/serve-docs.ts",
    "docs:preview": "bun run docs:build && bun run docs:serve",
    "onboarding": "bun run scripts/open-onboarding.ts",
    "test:onboarding": "bun test onboarding/wizard.test.ts",
    "reports:review-bundle": "bun run scripts/generate-report-review-bundle.ts",
    "generate-evals-json": "bun run evals/generate-evals-json.ts",
    "typecheck:cli": "./node_modules/typescript/bin/tsc --noEmit -p cli/tsconfig.json",
    "typecheck:dashboard": "./node_modules/typescript/bin/tsc --noEmit -p dashboard/tsconfig.json",
    "test:dashboard": "cd dashboard && bun run test",
    "format": "./node_modules/.bin/biome format --write .",
    "format:check": "./node_modules/.bin/biome format .",
    "prove": "bun run scripts/prove-e2e.ts",
    "verify": "bun run scripts/verify-integration.ts",
    "test:cli": "bun test cli/src evals/assert.test.ts evals/gate-runner.test.ts evals/eval-config.test.ts evals/execute.test.ts evals/run-evals.test.ts evals/grade.test.ts onboarding/wizard.test.ts markdown-render.test.ts scripts/agents-depth-check.test.ts scripts/skills-depth-check.test.ts scripts/generate-skill-evals.test.ts scripts/check-agent-config-matrix.test.ts scripts/check-description-references.test.ts scripts/check-referenced-files.test.ts evals/a2a/protocol.test.ts evals/a2a/case-spec.test.ts evals/a2a/compare-lib.test.ts types/report-payload-v1.test.ts",
    "agents-check": "bun run scripts/agents-check.ts",
    "check": "bun run validate-config && bun run schema:check && bun run report-schema:check && bun run check-sri && bun run agents-check && bun run agents-depth:strict && bun run skills-depth:strict && bun run validate-chains && bun run check-routers && bun run check-agent-matrix && bun run check-description-refs && bun run check-referenced-files && bun run check-write-gates && bun run check-name-collisions && bun run check-prompt-wiring && bun run validate:alias-drift --strict && bun run eval:validate && bun run eval:scaffold && bun run eval:scenarios-validate && bun run eval:routers && bun run eval:quick && bun run a2a && bun run test:gates && bun run test:cli && bun run test:dashboard && bun run typecheck:cli && bun run typecheck:dashboard && bun run format:check",
    "agents-depth": "bun run scripts/agents-depth-check.ts",
    "agents-depth:strict": "bun run scripts/agents-depth-check.ts --strict",
    "skills-depth": "bun run scripts/skills-depth-check.ts",
    "skills-depth:strict": "bun run scripts/skills-depth-check.ts --strict",
    "a2a": "bun run evals/a2a/run.ts",
    "a2a:list": "bun run evals/a2a/run.ts --list",
    "a2a:judge": "bun run evals/a2a/run.ts --require-judge",
    "single-eval-suite-regression-test": "bun run evals/a2a/run.ts --models claude",
    "multi-model-eval-suite-regression-test": "bun run evals/a2a/run.ts --models claude,codex",
    "eval:compare": "bun run evals/a2a/compare.ts",
    "eval:report": "bun run evals/a2a/html-report.ts",
    "eval:cleanup": "bun run evals/a2a/cleanup.ts",
    "schema:generate": "bun run scripts/generate-config-schema.ts",
    "schema:check": "bun run scripts/generate-config-schema.ts --check",
    "report-schema:generate": "bun run scripts/generate-report-schema.ts",
    "report-schema:check": "bun run scripts/generate-report-schema.ts --check",
    "check-sri": "bun run scripts/check-sri.ts",
    "eval:scaffold": "bun run scripts/check-eval-scaffold.ts",
    "crew:eval": "bun run cli/src/index.ts crew eval",
    "crew:eval:det": "bun run cli/src/index.ts crew eval --deterministic",
    "gen:skill-evals": "bun run scripts/generate-skill-evals.ts",
    "check-routers": "bun run scripts/check-router-children.ts",
    "check-agent-matrix": "bun run scripts/check-agent-config-matrix.ts --strict",
    "check-description-refs": "bun run scripts/check-description-references.ts --strict",
    "check-referenced-files": "bun run scripts/check-referenced-files.ts --strict",
    "check-write-gates": "bun run scripts/check-write-gates.ts",
    "check-name-collisions": "bun run scripts/check-name-collisions.ts",
    "check-prompt-wiring": "bun run scripts/check-prompt-wiring.ts",
    "test:gates": "bun test scripts/gates.test.ts scripts/agents-depth-check.test.ts scripts/skills-depth-check.test.ts"
  },
  "workspaces": [
    "cli",
    "dashboard"
  ],
  "dependencies": {
    "js-yaml": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "dompurify": "^3.2.4",
    "esbuild": "^0.28.1",
    "isomorphic-dompurify": "^2.28.0",
    "marked": "^15.0.7",
    "typescript": "^5.6.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "bin": {
    "jstackc": "cli/src/index.ts"
  }
}
