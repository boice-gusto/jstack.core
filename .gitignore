# jstack.core — standalone Git repo (Bun/TS + Python helpers + Next dashboard)

# Dependencies
node_modules/

# npm/yarn/pnpm lockfiles — this repo is bun-only (see CLAUDE.md). bun.lock is the
# only authoritative lockfile. These are ignored everywhere, at any depth, so a stray
# `npm install` can't commit a lockfile that disagrees with bun.lock.
package-lock.json
yarn.lock
pnpm-lock.yaml
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
# Exceptions: fixtures that intentionally contain a package-lock.json as test input.
!skills/skill-creator/improve-claude-md/**/package-lock.json
!cli/src/lib/__fixtures__/**/package-lock.json

# Builds & caches
dist/
build/
out/
.next/
.vercel/
*.tsbuildinfo

# Python (e.g. scripts/apply_detailed_skills.py)
__pycache__/
*.py[cod]
*$py.class

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Secrets & machine-local config (templates stay tracked)
.env
.env.*
!.env.example
jstack.config.json
jstack.personal.json
**/jstack.personal.json
.mcp.json

# Local scratch / workflow captures
.scratchpad/
.tmp/
artifacts/workflows/

# Brainstorming companion (mockups + state) — see skills/brainstorming
.superpowers/

# Setup recovery + lockfile (created by jstack setup)
.jstack/

# Skill eval LLM artifacts
evals/.workspace/
evals/.reports/

# Dashboard local persistence (server JSON)
.dashboard-data/

# Editors
.idea/
*.swp
*.swo

# The a2a CLI cases run `doctor` and `config show` against a real project config. The blanket
# jstack.config.json rule above matches by basename anywhere, which hid this fixture and made
# those six cases impossible to pass in CI (the repo root config is, correctly, never committed).
!evals/a2a/fixtures/project/jstack.config.json
