{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "cli/src/**/*.ts",
      "scripts/**/*.ts",
      "evals/**/*.ts",
      "constants/**/*.ts",
      "types/**/*.ts",
      "onboarding/**/*.ts",
      "mcp-mock/**/*.ts",
      "telemetry/**/*.ts",
      "*.ts",
      "docs.js",
      "docs-landing-entry.js",
      "docs-embed-hydrate.js",
      "markdown-render.js",
      "markdown-render-bundled.js",
      "md-preview.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": false
  }
}
